#!/bin/bash
#PBS -N unet_mem24h_dsst_temporal_radprecip_oro
#PBS -A ucsd0044
#PBS -q nvgpu
#PBS -l select=1:ncpus=16:ngpus=1:mem=235GB:gpu_type=a100
#PBS -l walltime=24:00:00
#PBS -o /glade/u/home/praggarwal/couple/output/logs/unet_mem24h_dsst_temporal_radprecip_oro.log
#PBS -e /glade/u/home/praggarwal/couple/output/logs/unet_mem24h_dsst_temporal_radprecip_oro.err
#PBS -j oe

COUPLE_DIR=/glade/u/home/praggarwal/couple
ZARR_GLOB="/glade/derecho/scratch/wchapman/b_credit_runs/b.e21.CREDIT_climate_branch_1980_????_zmdata_ERA5scaled_zmdata_Qtot.zarr"

set -euo pipefail
echo "PBS job started: $(date), node=$(hostname), jobid=$PBS_JOBID"

module load conda
conda activate /glade/work/praggarwal/conda-envs/atm

cd ${COUPLE_DIR}

# Same as submit_mem24h_dsst_temporal_radprecip.pbs but with --statics: two constant
# orography input channels (z_norm, LANDM_COSLAT) appended after dSST_dt -> n_in 6->8.
# Goal: improve wind-stress (TAUX/TAUY) skill via land/terrain context.
# New out_dir keeps the 6-channel model intact for an A/B R^2 comparison.
echo "Starting mem24h + dSST/dt + temporal + AUGMENT + DROPOUT 0.1 + RAD + PRECIP + STATICS at $(date)"
python -u train_unet.py \
    --zarr_glob     "${ZARR_GLOB}" \
    --out_dir       ${COUPLE_DIR}/output/output_unet_mem24h_dsst_temporal_radprecip_oro \
    --subsample     1.0 \
    --memory \
    --max_epochs    500 \
    --patience      40 \
    --batch         8 \
    --base          64 \
    --dsst_dt \
    --augment \
    --dropout       0.1 \
    --with_rad \
    --with_precip \
    --statics \
    --scheduler     cosine \
    --split_mode    temporal \
    --wandb_name    mem24h-dsst-temporal-radprecip-oro \
    --wandb_project couple-unet

echo "Done at $(date)"
