#!/bin/bash
#PBS -N unet_atm_aux
#PBS -A ucsd0044
#PBS -q nvgpu
#PBS -l select=1:ncpus=16:ngpus=1:mem=350GB:gpu_type=a100
#PBS -l walltime=24:00:00
#PBS -o /glade/u/home/praggarwal/couple/output/logs/unet_mem24h_atm_aux.log
#PBS -e /glade/u/home/praggarwal/couple/output/logs/unet_mem24h_atm_aux.err
#PBS -j oe

COUPLE_DIR=/glade/u/home/praggarwal/couple
ZARR_GLOB="/glade/derecho/scratch/wchapman/b_credit_runs/b.e21.CREDIT_climate_branch_1980_????_zmdata_ERA5scaled_zmdata_Qtot.zarr"

set -euo pipefail
echo "PBS job started: $(date), node=$(hostname), jobid=$PBS_JOBID"

module load conda
conda activate /glade/work/praggarwal/conda-envs/atm
cd ${COUPLE_DIR}

# EXPERIMENT: 8 flux targets + 5 auxiliary near-surface atm targets at t-1
# (Ubot,Vbot,Tbot,Qbot,PS). Plain MSE over all 13 outputs (no --loss_weights).
# Inputs unchanged (mem24h + dSST/dt). Requires Y_atm.npy + 13-ch normalizer.npz
# (built by scripts/prep_atm_aux.pbs).
echo "Starting mem24h + dSST/dt + AUGMENT + DROPOUT 0.1 + RAD + PRECIP + ATM(aux) MSE at $(date)"
python -u train_unet.py \
    --zarr_glob     "${ZARR_GLOB}" \
    --out_dir       ${COUPLE_DIR}/output/output_unet_mem24h_atm_aux \
    --subsample     1.0 \
    --memory \
    --dsst_dt \
    --augment \
    --dropout       0.1 \
    --with_rad \
    --with_precip \
    --with_atm \
    --loss          mse \
    --scheduler     cosine \
    --split_mode    temporal \
    --test_years    2013 2014 \
    --max_epochs    500 \
    --patience      40 \
    --batch         8 \
    --base          64 \
    --wandb_name    mem24h-atm-aux-mse \
    --wandb_project couple-unet

echo "Done at $(date)"
