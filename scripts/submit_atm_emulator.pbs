#!/bin/bash
#PBS -N atm_emulator
#PBS -A UCSD0044
#PBS -q nvgpu
#PBS -l select=1:ncpus=16:ngpus=1:mem=180GB:gpu_type=a100
#PBS -l walltime=04:00:00
#PBS -o /glade/u/home/praggarwal/couple/output/logs/atm_emulator.log
#PBS -j oe

# =============================================================================
# EXPERIMENT (2026-07-30): train the autoregressive near-surface ATMOSPHERE
# emulator (train_atm_emulator.py) so the coupled run can PREDICT Ubot/Vbot/
# Tbot/Qbot/PS instead of PRESCRIBING them from blstate files ("turn down the
# use of prescription"). Isolated: writes only output/output_atm_emulator.
# =============================================================================
COUPLE_DIR=/glade/u/home/praggarwal/couple
set -euo pipefail
echo "PBS start $(date)  node=$(hostname)  jobid=$PBS_JOBID"

module load conda
conda activate /glade/work/praggarwal/conda-envs/atm
cd ${COUPLE_DIR}

python -c "import torch; assert torch.cuda.is_available(), 'no CUDA'; print('CUDA OK:', torch.cuda.get_device_name(0))"

python -u train_atm_emulator.py \
    --out_dir     output/output_atm_emulator \
    --train_years 1980-1991 \
    --test_years  1992-1993 \
    --stride      2 \
    --epochs      40 \
    --batch       16 \
    --base        64 \
    --lr          3e-4 \
    --ema

echo "atm emulator training done $(date)"
