set -euo pipefail
module load conda
conda activate /glade/work/praggarwal/conda-envs/atm
cd /glade/u/home/praggarwal/couple

echo "=== preprocess_data_hpx.py (X, Y, mask, meta) ==="
python -u preprocess_data_hpx.py --nside 64

echo "=== add_rad_precip_to_cache_hpx.py (Y_rad, Y_precip) ==="
python -u add_rad_precip_to_cache_hpx.py --cache_dir /glade/work/praggarwal/couple_cache_hpx64

echo "=== DONE: cache contents ==="
ls -lh /glade/work/praggarwal/couple_cache_hpx64/
