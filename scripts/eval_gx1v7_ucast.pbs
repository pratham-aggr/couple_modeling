#!/bin/bash
#PBS -N gx1_ucast_ev
#PBS -A UCSD0044
#PBS -q nvgpu
#PBS -l select=1:ncpus=16:ngpus=1:mem=128GB:gpu_type=a100
#PBS -l walltime=02:00:00
#PBS -o /glade/u/home/praggarwal/couple/output/logs/gx1v7_ucast_eval.log
#PBS -e /glade/u/home/praggarwal/couple/output/logs/gx1v7_ucast_eval.err
#PBS -j oe

# U-Cast NATIVE gx1v7, Stage 2: probabilistic CRPS fine-tune with MC Dropout +
# AdamW lr=1e-4 + grad_clip + EMA (the settings that converged for m377oyqt;
# the Muon lr=2e-3 attempt diverged).  Loads Stage-1 MAE weights weights-only,
# fine-tunes on the unbiased CRPS estimator, writes crps_ssr_test.json.
# Chain after S1:  qsub -W depend=afterok:<s1_jobid> scripts/submit_gx1v7_ucast_s2.pbs

COUPLE_DIR=/glade/u/home/praggarwal/couple
ZARR_GLOB="/glade/derecho/scratch/praggarwal/zarr_gx1v7/b.e21.CREDIT_gx1v7_????.zarr"

set -euo pipefail
echo "PBS job started: $(date), node=$(hostname), jobid=$PBS_JOBID"

module load conda
conda activate /glade/work/praggarwal/conda-envs/atm

cd ${COUPLE_DIR}

echo "U-Cast NATIVE gx1v7 Stage 2: CRPS fine-tune (AdamW 1e-4, MC Dropout, EMA) at $(date)"
python -u train_unet.py \
    --zarr_glob     "${ZARR_GLOB}" \
    --out_dir       ${COUPLE_DIR}/output/output_unet_gx1v7_ucast \
    --cache_dir     /glade/work/praggarwal/couple_cache_gx1v7_mem24h \
    --grid_shape    320 384 \
    --subsample     1.0 \
    --memory \
    --dsst_dt \
    --augment \
    --with_rad \
    --with_precip \
    --loss          crps \
    --eval_test \
    --dropout       0.1 \
    --crps_members  2 \
    --optimizer     adamw \
    --lr            1e-4 \
    --grad_clip     1.0 \
    --ema \
    --eval_prob \
    --eval_members  8 \
    --max_epochs    50 \
    --patience      40 \
    --batch         8 \
    --base          64 \
    --scheduler     cosine \
    --split_mode    temporal \
    --test_years    2013 2014 \
    --wandb_name    mem24h-gx1v7-ucast-s2-crps-adamw \
    --wandb_project couple-unet

echo "U-Cast NATIVE gx1v7 Stage 2 done at $(date)"
