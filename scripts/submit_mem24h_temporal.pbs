#!/bin/bash
#PBS -N unet_mem24h_temporal
#PBS -A ucsd0044
#PBS -q nvgpu
#PBS -l select=1:ncpus=16:ngpus=1:mem=128GB:gpu_type=a100
#PBS -l walltime=24:00:00
#PBS -o /glade/u/home/praggarwal/couple/output/logs/unet_mem24h_temporal.log
#PBS -e /glade/u/home/praggarwal/couple/output/logs/unet_mem24h_temporal.err
#PBS -j oe

COUPLE_DIR=/glade/u/home/praggarwal/couple
ZARR_GLOB="/glade/derecho/scratch/wchapman/b_credit_runs/b.e21.CREDIT_climate_branch_1980_????_zmdata_ERA5scaled_zmdata_Qtot.zarr"

set -euo pipefail
echo "PBS job started: $(date), node=$(hostname), jobid=$PBS_JOBID"

module load conda
conda activate /glade/work/praggarwal/conda-envs/atm

cd ${COUPLE_DIR}

# CAMulator-style temporal split (Chapman et al. 2025):
#   train  1980-2010  (31 years, 88%)  normaliser computed on train only
#   val    2011-2012  ( 2 years,  6%)  early stopping
#   test   2013-2014  ( 2 years,  6%)  reported once after training
echo "Starting mem24h + temporal split at $(date)"
python -u train_unet.py \
    --zarr_glob     "${ZARR_GLOB}" \
    --out_dir       ${COUPLE_DIR}/output/output_unet_mem24h_temporal \
    --subsample     1.0 \
    --memory \
    --max_epochs    500 \
    --patience      40 \
    --batch         8 \
    --base          64 \
    --scheduler     cosine \
    --split_mode    temporal \
    --wandb_name    mem24h-temporal \
    --wandb_project couple-unet

echo "Done at $(date)"
