#!/bin/bash
#PBS -N atm_residual
#PBS -A UCSD0085
#PBS -q nvgpu
#PBS -l select=1:ncpus=32:ngpus=2:mem=200GB:gpu_type=a100
#PBS -l walltime=12:00:00
#PBS -o /glade/u/home/praggarwal/couple/output/logs/atm_emulator_residual.log
#PBS -j oe

# =============================================================================
# RESIDUAL (climatology-anchored) BL-atm wind emulator (2 x A100), wandb-tracked.
#
# WHY: the full-wind autoregressive emulator falls BELOW the +0.58 K climatology
# floor -- it either collapses to a blurred conditional mean (+1.37 K, dead
# ventilation) or extrapolates off-manifold and blows up (job 7000015, k.e.>100).
# The climatology-only run is bounded (+0.58) but carries no variability.
#
# FIX (this run): the net predicts only the wind ANOMALY on top of the fixed
# monthly climatology.  Served wind = clim_gx1v7.npy[month] + anomaly, with the
# climatology re-injected EVERY step as an anchor.  Consequences:
#   * worst case (anomaly -> 0) degrades to the *exact* climatology floor (+0.58),
#     which is proven bounded -- no compounding, no OOD blowup;
#   * extends past 2014 for free: climatology is a function of MONTH (cyclic), and
#     the anomaly is driven by the LIVE ocean state -- neither reads an archive;
#   * any real skill can only pull drift from +0.58 toward the real-wind +0.002.
# This is a physical-baseline residual parameterization, NOT variance inflation.
#
# --var_loss_weight: make the anomaly EARN variance/gradient-energy (else MSE
#   collapses it to ~0 = pure climatology).  --sst_perturb: keep the anomaly
#   physical under coupled warm/OOD SST drift.  Both are training-time objectives.
#
# Isolated: writes only output/output_atm_emulator_residual (saves best_model.pt,
# best_model_ema.pt, normalizer.npz, clim_gx1v7.npy, model_config.json,
# stability_test.json).  Touches no deployed checkpoint.
#   qsub scripts/submit_atm_emulator_residual.pbs
# =============================================================================
COUPLE_DIR=/glade/u/home/praggarwal/couple
set -euo pipefail
echo "PBS start $(date)  node=$(hostname)  jobid=$PBS_JOBID"

module load conda
conda activate /glade/work/praggarwal/conda-envs/atm
cd ${COUPLE_DIR}

python -c "import torch; n=torch.cuda.device_count(); assert n>=2, f'need 2 GPUs, got {n}'; print('GPUs:', [torch.cuda.get_device_name(i) for i in range(n)])"

python -u train_atm_emulator_rollout.py \
    --out_dir     output/output_atm_emulator_residual \
    --residual \
    --clim_years  1980-2014 \
    --train_years 1980-2010 \
    --val_years   2011-2012 \
    --test_years  2013-2014 \
    --rollout        8 \
    --rollout_start  2 \
    --rollout_ramp_epochs 8 \
    --stride      2 \
    --epochs      40 \
    --batch       16 \
    --base        64 \
    --lr          3e-4 \
    --dropout     0.1 \
    --var_loss_weight 0.5 \
    --sst_perturb 1.5 \
    --ema \
    --probe_steps 120 \
    --wandb_name    mem24h-atm-residual \
    --wandb_project couple-unet

echo "atm residual training done $(date)"
