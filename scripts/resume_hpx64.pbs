#!/bin/bash
#PBS -N train_hpx64_res
#PBS -A UCSD0085
#PBS -q casper
#PBS -l select=1:ncpus=16:ngpus=1:mem=350GB:gpu_type=a100
#PBS -l walltime=12:00:00
#PBS -o /glade/u/home/praggarwal/couple/output/logs/train_hpx64_resume.log
#PBS -j oe

set -euo pipefail
module load conda
conda activate /glade/work/praggarwal/conda-envs/atm
cd /glade/u/home/praggarwal/couple

CACHE=/glade/work/praggarwal/couple_cache_hpx64
OUT=output/output_hpx64_mem24h
ZGLOB="/glade/derecho/scratch/wchapman/b_credit_runs/b.e21.CREDIT_climate_branch_1980_????_zmdata_ERA5scaled_zmdata_Qtot.zarr"

echo "=== resume train_hpx from epoch 268 (warm-start best_model.pt, wandb eutl8ixm) ==="
python -u train_hpx.py --cache_dir $CACHE --out_dir $OUT --zarr_glob "$ZGLOB" \
    --nside 64 --base 64 --batch 8 --dropout 0.1 --dsst_dt --with_rad --with_precip \
    --num_workers 8 --max_epochs 500 --patience 40 \
    --resume_from $OUT/best_model.pt --start_epoch 268 --resume_best_val 0.2238 \
    --wandb_project couple-unet --wandb_id eutl8ixm \
    --wandb_name hpx64-mem24h-dsst-radprecip-do0.1
