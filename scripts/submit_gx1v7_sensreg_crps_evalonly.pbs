#!/bin/bash
#PBS -N crps_ssr_eval
#PBS -A UCSD0044
#PBS -q nvgpu
#PBS -l select=1:ncpus=16:ngpus=1:mem=128GB:gpu_type=a100
#PBS -l walltime=01:00:00
#PBS -o /glade/u/home/praggarwal/couple/output/logs/gx1v7_sensreg_crps_evalonly.log
#PBS -j oe

# =============================================================================
# EVAL-ONLY: get the CRPS/SSR calibration number for the completed CRPS Stage-2
# fine-tune (output_unet_gx1v7_sensreg_crps).  The training job (5414853) finished
# and saved best_model.pt + deterministic metrics, but crashed in the cosmetic
# _log_rmse_maps() diagnostic (mask 320 vs 384) BEFORE the CRPS/SSR block ran, so
# crps_ssr_test.json was never written.
#
# --eval_test SKIPS training entirely, loads best_model.pt, runs compute_metrics
# then compute_crps_ssr (8-member BN-safe MC Dropout) and writes crps_ssr_test.json.
# It never touches _log_rmse_maps, so the crash cannot recur.  --dropout 0.1 is
# REQUIRED so the UNet is built with Dropout layers for MC Dropout to sample.
# No --resume / --init_weights (eval_test loads best_model.pt directly); no wandb.
# =============================================================================

COUPLE_DIR=/glade/u/home/praggarwal/couple
ZARR_GLOB="/glade/derecho/scratch/praggarwal/zarr_gx1v7/b.e21.CREDIT_gx1v7_????.zarr"

set -euo pipefail
echo "PBS job started: $(date), node=$(hostname), jobid=$PBS_JOBID"

module load conda
conda activate /glade/work/praggarwal/conda-envs/atm

cd ${COUPLE_DIR}

python -c "import torch; assert torch.cuda.is_available(), 'CUDA unavailable on this node'; print('CUDA OK:', torch.cuda.get_device_name(0))"

echo "CRPS/SSR eval-only on output_unet_gx1v7_sensreg_crps at $(date)"
python -u train_unet.py \
    --zarr_glob     "${ZARR_GLOB}" \
    --out_dir       ${COUPLE_DIR}/output/output_unet_gx1v7_sensreg_crps \
    --cache_dir     /glade/work/praggarwal/couple_cache_gx1v7_mem24h \
    --grid_shape    320 384 \
    --subsample     1.0 \
    --memory \
    --dsst_dt \
    --with_atm_in \
    --with_rad \
    --with_precip \
    --dropout       0.1 \
    --base          64 \
    --split_mode    temporal \
    --test_years    2013 2014 \
    --eval_test \
    --eval_prob \
    --eval_members  8

echo "CRPS/SSR eval done at $(date); see output/output_unet_gx1v7_sensreg_crps/crps_ssr_test.json"
