#!/bin/bash
#PBS -N build_cache_cice
#PBS -A UCSD0085
#PBS -q casper
#PBS -l select=1:ncpus=8:mem=120GB
#PBS -l walltime=04:00:00
#PBS -o /glade/u/home/praggarwal/couple/output/logs/build_cache_cice.log
#PBS -j oe

# Build the gx1v7 monthly CICE emulator cache from CESM2-LE ice+ocn tseries.
# One member (.002 = the standalone POP restart member) over 1850-2100 gives
# ~3100 monthly samples; add --members for more internal-variability diversity.
set -euo pipefail
module load conda
conda activate /glade/work/praggarwal/conda-envs/atm
cd /glade/u/home/praggarwal/couple

CACHE=/glade/derecho/scratch/praggarwal/couple_cache_cice_solin

echo "=== preprocess_cice.py (X, Y, mask, meta) — WIND-FREE + SOLIN (online-coupling variant) ==="
python -u preprocess_cice.py --cache_dir "$CACHE" \
    --members LE2-1231.002 --year_start 1850 --year_end 2100

echo "=== done: cache contents ==="
ls -la "$CACHE"
